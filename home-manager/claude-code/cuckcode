#!/usr/bin/env bash
# cuckcode — Claude Code with the ghostbus push channel loaded.
#
# The channel server is a top-level user MCP server named `ghostbus-channel`,
# added by home-manager's activation (`claude mcp add --scope user`) and hosted
# by systemd as a per-connection service on
# $XDG_RUNTIME_DIR/ghostbus-channel.sock. A top-level configured server is what
# the accepted `server:ghostbus-channel` channel tag resolves; neither the
# skills-dir `hm` plugin nor a per-session `--mcp-config` entry is used.
#
# Bind the flag with `=` and put the user's arguments after it: the
# space-separated spelling consumes following positional arguments as channel
# selectors, so `/resume` or a prompt never reaches Claude Code.
set -euo pipefail
selector=${CLAUDE_CHANNEL_SELECTOR:-server:ghostbus-channel}
exec claude --dangerously-load-development-channels="$selector" "$@"
