{
  "$schema": "https://opencode.ai/v2/cli.json",
  "attention": { "notifications": true, "sound": true, "volume": 0.3 },
  "plugins": [
    {
      "package": "@max10240/opencode-plugin-unicorn",
      "options": {
        "features": {
          "god": false,
          "imageGen": false,
          "showImg": false,
          "opencodeGoUsage": false,
          "notepad": false,
          "recommendedOpencodeConfig": false,
          "nonBlocking": true,
          "delayedQueue": true,
          "infiniteLoop": true,
          "retry": true,
          "promptSearch": true,
          "sessionSearch": true,
          "sendMessageAcrossSessions": true,
          "sensitiveEncrypt": true,
          "sensitiveProtection": true
        },
        "nonBlocking": { "thresholdMs": 10000 }
      }
    }
  ]
}
